# ==========================================
# DevFlow CRM — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.
# ==========================================

# Server
NODE_ENV=development
SERVER_PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://devflow_user:devflow_pass@localhost:5432/devflow_crm
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devflow_crm
DB_USER=devflow_user
DB_PASSWORD=devflow_pass

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (NodeMailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="DevFlow CRM <no-reply@devflow.local>"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
